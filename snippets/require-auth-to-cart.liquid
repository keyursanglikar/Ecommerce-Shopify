{% unless customer %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Do not run interception if inside Shopify Theme Customizer Admin
      if (window.Shopify && window.Shopify.designMode) {
        return;
      }

      function interceptAddToCart(e) {
        const atcBtn = e.target.closest(
          '.pz-atc__btn, .product-form__submit, button[name="add"], .btn-custom-add-to-cart, form[action*="/cart/add"] button[type="submit"]'
        );

        if (atcBtn) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();

          // Navigate cleanly to login
          window.location.href = '/account/login';
        }
      }

      document.addEventListener('click', interceptAddToCart, true);
    });
  </script>
{% endunless %}
