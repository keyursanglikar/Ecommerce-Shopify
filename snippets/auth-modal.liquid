<div class="pz-auth-modal" id="pzAuthModal">
  <div class="pz-auth-overlay" onclick="closeAuthModal()"></div>
  <div class="pz-auth-box">
    <button type="button" class="pz-auth-close" onclick="closeAuthModal()" aria-label="Close">&times;</button>
    
    <!-- Tab Switchers -->
    <div class="pz-auth-tabs">
      <button type="button" class="pz-auth-tab active" id="tabLoginBtn" onclick="switchAuthTab('login')">Login</button>
      <button type="button" class="pz-auth-tab" id="tabRegisterBtn" onclick="switchAuthTab('register')">Create Account</button>
    </div>

    <!-- 1. LOGIN FORM -->
    <div class="pz-auth-form-wrap" id="loginFormWrap">
      <div class="pz-auth-header">
        <h3>Welcome Back!</h3>
        <p>Log in to track orders, save wishlist, and claim VIP deals.</p>
      </div>

      {% form 'customer_login' %}
        {{ form.errors | default_errors }}

        <div class="pz-form-group">
          <label>Email Address</label>
          <input type="email" name="customer[email]" placeholder="name@example.com" required autocomplete="email">
        </div>

        <div class="pz-form-group">
          <div class="pz-label-row">
            <label>Password</label>
            <a href="/account/login#recover" class="pz-forgot-link">Forgot?</a>
          </div>
          <input type="password" name="customer[password]" placeholder="Enter password" required autocomplete="current-password">
        </div>

        <button type="submit" class="pz-btn-auth-submit">Sign In &rarr;</button>
      {% endform %}

      <div class="pz-auth-switch-prompt">
        Don't have an account? <a href="javascript:void(0)" onclick="switchAuthTab('register')">Sign up free</a>
      </div>
    </div>

    <!-- 2. REGISTER FORM -->
    <div class="pz-auth-form-wrap" id="registerFormWrap" style="display: none;">
      <div class="pz-auth-header">
        <h3>Join the VIP Club</h3>
        <p>Sign up to unlock secret drops &amp; Buy 4 Get 3 Free coupons.</p>
      </div>

      {% form 'create_customer' %}
        {{ form.errors | default_errors }}

        <div class="pz-form-row">
          <div class="pz-form-group">
            <label>First Name</label>
            <input type="text" name="customer[first_name]" placeholder="First name" required>
          </div>
          <div class="pz-form-group">
            <label>Last Name</label>
            <input type="text" name="customer[last_name]" placeholder="Last name">
          </div>
        </div>

        <div class="pz-form-group">
          <label>Email Address</label>
          <input type="email" name="customer[email]" placeholder="name@example.com" required autocomplete="email">
        </div>

        <div class="pz-form-group">
          <label>Password</label>
          <input type="password" name="customer[password]" placeholder="Create a strong password (6+ chars)" required autocomplete="new-password">
        </div>

        <button type="submit" class="pz-btn-auth-submit">Create Account &rarr;</button>
      {% endform %}

      <div class="pz-auth-switch-prompt">
        Already have an account? <a href="javascript:void(0)" onclick="switchAuthTab('login')">Log in</a>
      </div>
    </div>
  </div>
</div>

<style>
  .pz-auth-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    font-family: 'Barlow', system-ui, sans-serif;
  }
  .pz-auth-modal.is-open {
    display: flex;
  }
  .pz-auth-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    animation: pzFadeIn 0.2s ease;
  }
  .pz-auth-box {
    position: relative;
    background: #ffffff;
    width: 90%;
    max-width: 440px;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    z-index: 2;
    animation: pzScaleUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pz-auth-close {
    position: absolute;
    top: 14px;
    right: 18px;
    background: none;
    border: none;
    font-size: 26px;
    color: #94a3b8;
    cursor: pointer;
    line-height: 1;
    transition: color 0.15s;
  }
  .pz-auth-close:hover {
    color: #000;
  }
  .pz-auth-tabs {
    display: flex;
    border-bottom: 2px solid #f1f5f9;
    margin-bottom: 1.5rem;
  }
  .pz-auth-tab {
    flex: 1;
    background: none;
    border: none;
    padding: 10px 0;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #94a3b8;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: all 0.2s;
  }
  .pz-auth-tab.active {
    color: #000000;
    border-bottom-color: #000000;
  }
  .pz-auth-header h3 {
    font-size: 1.4rem;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 0.25rem;
    color: #000;
  }
  .pz-auth-header p {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0 0 1.25rem;
    line-height: 1.4;
  }
  .pz-form-group {
    margin-bottom: 1rem;
  }
  .pz-form-row {
    display: flex;
    gap: 10px;
  }
  .pz-form-row .pz-form-group {
    flex: 1;
  }
  .pz-form-group label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #1e293b;
    margin-bottom: 0.35rem;
  }
  .pz-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pz-forgot-link {
    font-size: 0.75rem;
    color: #64748b;
    text-decoration: underline;
  }
  .pz-form-group input {
    width: 100%;
    height: 44px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0 12px;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.15s;
  }
  .pz-form-group input:focus {
    border-color: #000000;
  }
  .pz-btn-auth-submit {
    width: 100%;
    height: 46px;
    background: #000000;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 0.5rem;
    transition: background 0.15s;
  }
  .pz-btn-auth-submit:hover {
    background: #262626;
  }
  .pz-auth-switch-prompt {
    font-size: 0.85rem;
    color: #64748b;
    text-align: center;
    margin-top: 1.25rem;
  }
  .pz-auth-switch-prompt a {
    color: #000000;
    font-weight: 800;
    text-decoration: underline;
  }
  @keyframes pzFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes pzScaleUp {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<script>
  function openAuthModal(defaultTab = 'login') {
    const modal = document.getElementById('pzAuthModal');
    if (modal) {
      switchAuthTab(defaultTab);
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeAuthModal() {
    const modal = document.getElementById('pzAuthModal');
    if (modal) {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  }

  function switchAuthTab(tab) {
    const loginWrap = document.getElementById('loginFormWrap');
    const registerWrap = document.getElementById('registerFormWrap');
    const tabLogin = document.getElementById('tabLoginBtn');
    const tabRegister = document.getElementById('tabRegisterBtn');

    if (tab === 'register') {
      loginWrap.style.display = 'none';
      registerWrap.style.display = 'block';
      tabLogin.classList.remove('active');
      tabRegister.classList.add('active');
    } else {
      loginWrap.style.display = 'block';
      registerWrap.style.display = 'none';
      tabLogin.classList.add('active');
      tabRegister.classList.remove('active');
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Attach to account icon triggers in navbar
    const accountButtons = document.querySelectorAll('.pz-account-btn, a[href*="/account/login"]');
    accountButtons.forEach(btn => {
      {% unless customer %}
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          openAuthModal('login');
        });
      {% endunless %}
    });
  });
</script>
