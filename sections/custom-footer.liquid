{{ 'section-poster-footer.css' | asset_url | stylesheet_tag }}

<footer class="pz-footer">
  <div class="pz-footer-inner page-width">
    <!-- Top Help Bar -->
    <a href="{{ section.settings.help_link | default: '/pages/contact' }}" class="pz-footer-help-pill">
      <span>Need help with an order?</span>
      <span class="gold-text">Help &amp; Support &rarr;</span>
    </a>

    <!-- Footer Main Columns -->
    <div class="pz-footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="pz-footer-col brand-col">
        <h3 class="pz-footer-logo">{{ section.settings.brand_name | default: "POSTERIZED" }}<span>.</span></h3>
        <p class="pz-footer-tagline">
          {{ section.settings.brand_tagline | default: "India's OG No.1 destination for 300 GSM aesthetic room posters, wall collage kits, and multi-piece split canvas art." }}
        </p>
        <div class="pz-footer-specs">
          <span class="spec-badge">✨ 300 GSM Matte Board</span>
          <span class="spec-badge">💧 Fade-Proof HD Inks</span>
          <span class="spec-badge">📦 Free Wall Tape Included</span>
        </div>
      </div>

      <!-- Col 2: Shop Links -->
      <div class="pz-footer-col">
        <h4 class="pz-footer-heading">Shop Collections</h4>
        <ul class="pz-footer-links">
          <li><a href="/collections/all">All Wall Posters</a></li>
          <li><a href="/collections">Wall Setup Packs <span class="hot-badge">HOT</span></a></li>
          <li><a href="/collections">3-Piece &amp; 4-Piece Splits</a></li>
          <li><a href="/collections">8-Piece Panoramic Art</a></li>
          <li><a href="/products">Custom Photo Prints</a></li>
          <li><a href="/collections">Anime &amp; Manga</a></li>
          <li><a href="/collections">Formula 1 &amp; Supercars</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div class="pz-footer-col">
        <h4 class="pz-footer-heading">Customer Care</h4>
        <ul class="pz-footer-links">
          <li><a href="/pages/contact">Track Your Order</a></li>
          <li><a href="/pages/contact">Help &amp; FAQs</a></li>
          <li><a href="/policies/shipping-policy">Shipping &amp; Delivery</a></li>
          <li><a href="/policies/refund-policy">Returns &amp; Replacements</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter & Social -->
      <div class="pz-footer-col">
        <h4 class="pz-footer-heading">Join the VIP Club</h4>
        <p class="pz-footer-sub">Get secret drops, buy-one-get-one coupons &amp; room decor inspo.</p>
        {% form 'customer', class: 'pz-footer-newsletter' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="pz-input-row">
            <input type="email" name="contact[email]" placeholder="Enter your email" required class="pz-email-input">
            <button type="submit" class="pz-newsletter-btn" aria-label="Subscribe">&rarr;</button>
          </div>
        {% endform %}
        <div class="pz-footer-contact">
          <p>Support: <a href="mailto:{{ section.settings.support_email | default: 'support@posterized.in' }}">{{ section.settings.support_email | default: 'support@posterized.in' }}</a></p>
        </div>
      </div>
    </div>

    <!-- Legal Fan Art Disclaimer Box -->
    <div class="pz-footer-disclaimer">
      Fan art, not official merchandise unless stated. Artwork concerns: 
      <a href="mailto:{{ section.settings.support_email | default: 'support@posterized.in' }}">support@posterized.in</a> 
      &middot; Order help: <a href="{{ section.settings.help_link | default: '/pages/contact' }}">Help Center</a> 
      &middot; &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.
    </div>

    <!-- Bottom Copyright & Policy Strip -->
    <div class="pz-footer-bottom">
      <div class="pz-footer-bottom-copy">
        &copy; {{ 'now' | date: "%Y" }}, {{ shop.name }}. India's #1 Poster Store.
      </div>
      <div class="pz-footer-payment-icons">
        <span class="pay-chip">UPI</span>
        <span class="pay-chip">Google Pay</span>
        <span class="pay-chip">PhonePe</span>
        <span class="pay-chip">Paytm</span>
        <span class="pay-chip">Cards / Net Banking</span>
        <span class="pay-chip">Cash on Delivery</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Posterized Custom Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "POSTERIZED"
    },
    {
      "type": "textarea",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "India's OG No.1 destination for 300 GSM aesthetic room posters, wall collage kits, and multi-piece split canvas art."
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support Email",
      "default": "support@posterized.in"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Help & Support Link"
    }
  ],
  "presets": [
    {
      "name": "Posterized Custom Footer"
    }
  ]
}
{% endschema %}
