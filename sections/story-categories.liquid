{{ 'section-story-categories.css' | asset_url | stylesheet_tag }}

<div class="story-categories-wrapper page-width">
  {% if section.settings.title != blank %}
    <div class="story-categories__header">
      <h2 class="story-categories__title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="story-categories__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="story-categories__scroll">
    <div class="story-categories__list">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: '#' }}" class="story-category__item" {{ block.shopify_attributes }}>
          <div class="story-category__ring {% if block.settings.highlight %}story-category__ring--highlight{% endif %}">
            <div class="story-category__image-box">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 200 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="90"
                  height="90"
                >
              {% else %}
                <div class="story-category__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
            {% if block.settings.badge != blank %}
              <span class="story-category__badge">{{ block.settings.badge }}</span>
            {% endif %}
          </div>
          <span class="story-category__label">{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Story Categories Slider",
  "tag": "section",
  "class": "section-story-categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Browse by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Find posters for your room aesthetic"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Bubble",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Anime"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (e.g. HOT, NEW)",
          "default": "HOT"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Gradient Ring Highlight",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Posterized Story Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Anime", "badge": "HOT" } },
        { "type": "category", "settings": { "title": "F1 & Cars", "badge": "TREND" } },
        { "type": "category", "settings": { "title": "Split Sets", "badge": "POPULAR" } },
        { "type": "category", "settings": { "title": "Gym & Quotes", "badge": "" } },
        { "type": "category", "settings": { "title": "Gaming", "badge": "" } },
        { "type": "category", "settings": { "title": "Custom Prints", "badge": "NEW" } }
      ]
    }
  ]
}
{% endschema %}
