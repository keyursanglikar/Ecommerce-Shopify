{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer account page-width" style="max-width: 1080px; margin: 3rem auto; padding: 0 1.5rem; font-family: 'Barlow', system-ui, sans-serif;">
  <!-- Account Top Banner -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000; padding-bottom: 1.25rem; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <span style="font-size: 0.8rem; font-weight: 800; color: #ef4444; letter-spacing: 0.1em; text-transform: uppercase;">Customer Dashboard</span>
      <h1 style="font-size: 2.25rem; font-weight: 900; text-transform: uppercase; margin: 0.25rem 0 0;">Welcome, {{ customer.first_name | default: 'VIP Member' }}!</h1>
      <p style="color: #64748b; font-size: 0.95rem; margin: 0.25rem 0 0;">Manage your poster orders, shipping addresses, and exclusive member discounts.</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="/collections/all" style="display: inline-block; padding: 10px 20px; background: #000; color: #fff; font-size: 0.9rem; font-weight: 800; border-radius: 8px; text-decoration: none; text-transform: uppercase;">Shop Posters &rarr;</a>
      <a href="/account/logout" style="display: inline-block; padding: 10px 18px; border: 1px solid #cbd5e1; color: #1e293b; font-size: 0.9rem; font-weight: 700; border-radius: 8px; text-decoration: none;">Log Out</a>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2.5rem;">
    <!-- Left Column: Order History -->
    <div>
      <h2 style="font-size: 1.35rem; font-weight: 900; text-transform: uppercase; margin: 0 0 1rem;">Order History</h2>
      
      {% paginate customer.orders by 10 %}
        {% if customer.orders.size != 0 %}
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            {% for order in customer.orders %}
              <div style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; background: #ffffff;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                  <div>
                    <strong style="font-size: 1.05rem;">Order {{ order.name }}</strong>
                    <span style="font-size: 0.85rem; color: #64748b; margin-left: 8px;">{{ order.created_at | date: "%B %d, %Y" }}</span>
                  </div>
                  <span style="background: #f1f5f9; padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">
                    {{ order.financial_status_label }}
                  </span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 0.75rem;">
                  <span style="font-size: 0.9rem; color: #64748b;">Total: <strong>{{ order.total_price | money }}</strong></span>
                  <a href="{{ order.customer_url }}" style="font-size: 0.85rem; font-weight: 700; color: #000; text-decoration: underline;">View Order &rarr;</a>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <!-- No orders yet view -->
          <div style="border: 2px dashed #e2e8f0; border-radius: 12px; padding: 2.5rem 2rem; text-align: center; background: #f8fafc;">
            <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🖼️</div>
            <h3 style="font-size: 1.15rem; font-weight: 800; text-transform: uppercase; margin: 0 0 0.5rem;">No Orders Placed Yet</h3>
            <p style="color: #64748b; font-size: 0.9rem; margin: 0 0 1.5rem;">Ready to upgrade your empty bedroom or desk wall? Explore our trending 300 GSM collections.</p>
            <a href="/collections/all" style="display: inline-block; padding: 12px 24px; background: #000; color: #fff; font-size: 0.9rem; font-weight: 800; border-radius: 8px; text-decoration: none; text-transform: uppercase;">
              Browse Trending Posters
            </a>
          </div>
        {% endif %}
      {% endpaginate %}

      <!-- Member Perks Box -->
      <div style="margin-top: 2rem; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 12px; padding: 1.5rem;">
        <h4 style="font-size: 1rem; font-weight: 900; text-transform: uppercase; color: #b45309; margin: 0 0 0.5rem;">👑 VIP Member Perks Active</h4>
        <ul style="margin: 0; padding-left: 1.25rem; font-size: 0.9rem; color: #78350f; line-height: 1.6;">
          <li>Automatic <strong>Buy 4 Get 3 Free</strong> &amp; <strong>Buy 5 Get 5 Free</strong> discount tiers.</li>
          <li><strong>Free Express Delivery</strong> on all prepaid orders across India.</li>
          <li>Free 48-Hour Damage Replacement Guarantee.</li>
        </ul>
      </div>
    </div>

    <!-- Right Column: Account & Shipping Details -->
    <div>
      <h2 style="font-size: 1.35rem; font-weight: 900; text-transform: uppercase; margin: 0 0 1rem;">Default Delivery Details</h2>
      <div style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; background: #ffffff;">
        <h3 style="font-size: 1.05rem; font-weight: 800; margin: 0 0 0.75rem;">{{ customer.name }}</h3>
        <p style="font-size: 0.9rem; color: #64748b; margin: 0 0 0.5rem;"><strong>Email:</strong> {{ customer.email }}</p>
        
        {% if customer.default_address %}
          <div style="font-size: 0.9rem; color: #475569; line-height: 1.5; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #f1f5f9;">
            <p style="margin: 0;"><strong>Shipping Address:</strong></p>
            {{ customer.default_address | format_address }}
          </div>
        {% endif %}

        <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #f1f5f9;">
          <a href="/account/addresses" style="font-size: 0.85rem; font-weight: 700; color: #000; text-decoration: underline;">
            Manage Addresses ({{ customer.addresses_count }}) &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Account Dashboard",
  "settings": []
}
{% endschema %}
