<script>
  /* headline: the number counts up from 0 (Indian grouping), then line 2
     slides in with a gold underline. Skipped under reduced-motion. */
  (function () {
    var h = document.currentScript.previousElementSibling.querySelector('[data-pz-count]');
    if (!h) return;
    var l1 = h.querySelector('.l1'), txt = l1.textContent, m = txt.match(/[\d,]+/);
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!m || reduce) { h.classList.add('done'); return; }
    var target = parseInt(m[0].replace(/,/g, ''), 10), pre = txt.slice(0, m.index), post = txt.slice(m.index + m[0].length);
    var num = document.createElement('span'); num.className = 'num'; num.textContent = '0';
    l1.textContent = ''; l1.appendChild(document.createTextNode(pre)); l1.appendChild(num); l1.appendChild(document.createTextNode(post));
    var fmt = function (n) { return n.toLocaleString('en-IN'); };
    var t0, dur = 1800;
    var step = function (ts) {
      if (!t0) t0 = ts;
      var k = Math.min(1, (ts - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      num.textContent = fmt(Math.round(target * e));
      if (k < 1) requestAnimationFrame(step); else h.classList.add('done');
    };
    /* Arjun 04-09: replay every 15 s while the headline is on screen */
    var run = function () { h.classList.remove('done'); t0 = null; num.textContent = '0'; requestAnimationFrame(step); };
    var visible = true, started = false;
    var tick = function () { if (visible && !document.hidden) run(); };
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (en) {
        visible = en[0].isIntersecting;
        if (visible && !started) { started = true; run(); setInterval(tick, 15000); }
      });
      io.observe(h);
    } else { run(); setInterval(tick, 15000); }
  })();
</script>

