      }
    </style>
    <div class="grid3 pz-row" style="--n:4"><a class="cg" href="/products/personalize-your-wall-space"><img src="//www.posterized.in/cdn/shop/files/custom_36a826e7-a7e6-4025-9e24-1cddaa3eb898.webp?v=1767176286&width=540" alt="Custom posters" loading="lazy" width="120" height="150"><div class="t">Custom posters</div>
          <div class="p">from ₹99</div>
        </a><a class="cg" href="/products/custom-retro-prints" ><img src="//www.posterized.in/cdn/shop/files/a6_0378f882-0c62-4116-83b8-90619198b73f.webp?v=1767173575&width=540" alt="Retro prints" loading="lazy" width="120" height="150"><div class="t">Retro prints</div>
          <div class="p">10 for ₹179</div>
        </a><a class="cg" href="/products/custom-pocket-prints" ><img src="//www.posterized.in/cdn/shop/files/pz-home-mini.jpg?v=1790657368&width=540" alt="Mini pocket photos" loading="lazy" width="120" height="150"><div class="t">Mini pocket photos</div>
          <div class="p">5 for ₹99</div>
        </a><a class="cg" href="/products/custom-photobooth-strip" ><img src="//www.posterized.in/cdn/shop/files/pz-home-strip.jpg?v=1790657368&width=540" alt="Photobooth strips" loading="lazy" width="120" height="150"><div class="t">Photobooth strips</div>
          <div class="p">3 for ₹149</div>
        </a></div>
