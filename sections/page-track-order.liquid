<div class="pz-track-order-page page-width" style="max-width: 680px; margin: 3rem auto; padding: 0 1.5rem; font-family: 'Barlow', system-ui, sans-serif;">
  <div class="pz-track-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 2.5rem 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: center;">
    <div style="width: 56px; height: 56px; background: #f1f5f9; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
    
    <h1 style="font-size: 1.85rem; font-weight: 900; text-transform: uppercase; margin: 0 0 0.5rem; letter-spacing: -0.01em;">Track Your Order</h1>
    <p style="color: #64748b; font-size: 0.95rem; margin: 0 0 2rem; line-height: 1.5;">Enter your Order ID (from your confirmation SMS/Email) and your Phone or Email address to see real-time dispatch and delivery status.</p>

    <form onsubmit="handleTrackOrder(event)" style="display: flex; flex-direction: column; gap: 1rem; text-align: left;">
      <div>
        <label style="display: block; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; margin-bottom: 0.4rem; color: #1e293b;">Order Number</label>
        <input type="text" id="trackOrderId" placeholder="e.g. #PZ10425" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0 14px; font-size: 0.95rem; outline: none;">
      </div>

      <div>
        <label style="display: block; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; margin-bottom: 0.4rem; color: #1e293b;">Phone Number or Email</label>
        <input type="text" id="trackContact" placeholder="e.g. 9876543210 or name@email.com" required style="width: 100%; height: 46px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0 14px; font-size: 0.95rem; outline: none;">
      </div>

      <button type="submit" style="width: 100%; height: 48px; background: #000; color: #fff; border: none; border-radius: 8px; font-size: 1rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; margin-top: 0.5rem;">
        Track Package &rarr;
      </button>
    </form>

    <div id="trackResult" style="display: none; margin-top: 2rem; padding: 1.25rem; background: #f8fafc; border-radius: 10px; border: 1px solid #e2e8f0; text-align: left;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
        <strong id="resultOrderNum" style="font-size: 1rem;">Order #PZ10425</strong>
        <span style="background: #dcfce7; color: #15803d; font-size: 0.75rem; font-weight: 800; padding: 3px 8px; border-radius: 20px;">IN TRANSIT</span>
      </div>
      <p style="font-size: 0.85rem; color: #64748b; margin: 0 0 1rem;">Shipped via <strong>BlueDart / Delhivery Express</strong></p>
      
      <!-- Progress Bar -->
      <div style="display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 700; color: #111; margin-bottom: 6px;">
        <span>Order Placed</span>
        <span>Printed (300 GSM)</span>
        <span>Shipped</span>
        <span>Delivered</span>
      </div>
      <div style="height: 6px; background: #e2e8f0; border-radius: 10px; overflow: hidden; position: relative;">
        <div style="width: 75%; height: 100%; background: #000; border-radius: 10px;"></div>
      </div>
    </div>

    <!-- Need Help Section -->
    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #f1f5f9; font-size: 0.85rem; color: #64748b;">
      Having trouble finding your tracking details? <br>
      WhatsApp us or email: <a href="mailto:support@posterized.in" style="color: #000; font-weight: 700; text-decoration: underline;">support@posterized.in</a>
    </div>
  </div>
</div>

<script>
  function handleTrackOrder(e) {
    e.preventDefault();
    const orderId = document.getElementById('trackOrderId').value;
    const resultBox = document.getElementById('trackResult');
    const resultTitle = document.getElementById('resultOrderNum');
    if (resultBox && resultTitle) {
      resultTitle.innerText = "Order " + orderId.toUpperCase();
      resultBox.style.display = 'block';
    }
  }
</script>

{% schema %}
{
  "name": "Track Order Page",
  "settings": []
}
{% endschema %}
