<div class="pz-reviews-page page-width" style="max-width: 1040px; margin: 3rem auto; padding: 0 1.5rem; font-family: 'Barlow', system-ui, sans-serif;">
  <div style="text-align: center; margin-bottom: 2.5rem;">
    <div style="display: inline-flex; align-items: center; gap: 6px; background: #fff8e1; border: 1px solid #ffe082; padding: 6px 14px; border-radius: 20px; font-weight: 800; font-size: 0.85rem; color: #b78103; margin-bottom: 0.75rem;">
      <span>★ ★ ★ ★ ★</span>
      <span>4.9 / 5 Overall Rating</span>
    </div>
    <h1 style="font-size: 2.5rem; font-weight: 900; text-transform: uppercase; margin: 0 0 0.5rem;">Real Rooms. Real Customers.</h1>
    <p style="color: #64748b; font-size: 1rem; max-width: 580px; margin: 0 auto;">See how 500,000+ bedrooms, gaming setups, and home workspaces look with our 300 GSM posters and split sets.</p>
  </div>

  <!-- Review Gallery Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
    <!-- Review Card 1 -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
      <img src="//www.posterized.in/cdn/shop/files/porschesetwall2.jpg?v=1784097463&width=500" alt="Porsche setup review" style="width: 100%; aspect-ratio: 4/3; object-fit: cover;">
      <div style="padding: 1.25rem;">
        <div style="color: #f59e0b; font-size: 0.9rem; margin-bottom: 0.4rem;">★ ★ ★ ★ ★</div>
        <p style="font-size: 0.9rem; color: #334155; line-height: 1.5; margin: 0 0 0.75rem;">"The 300 GSM quality is insane! Put up the Porsche GT3 RS split set over my desk and it completely changed the vibe of my room."</p>
        <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: #64748b; font-weight: 700;">
          <span>Rohan V. &middot; Mumbai</span>
          <span style="color: #16a34a;">✔ Verified Buyer</span>
        </div>
      </div>
    </div>

    <!-- Review Card 2 -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
      <img src="//www.posterized.in/cdn/shop/files/WallNew1.jpg?v=1791194103&width=500" alt="Batman review" style="width: 100%; aspect-ratio: 4/3; object-fit: cover;">
      <div style="padding: 1.25rem;">
        <div style="color: #f59e0b; font-size: 0.9rem; margin-bottom: 0.4rem;">★ ★ ★ ★ ★</div>
        <p style="font-size: 0.9rem; color: #334155; line-height: 1.5; margin: 0 0 0.75rem;">"Ordered the Buy 5 Get 5 Free mix and match deal. Got 10 posters for the price of 5! The pre-applied tape is super strong."</p>
        <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: #64748b; font-weight: 700;">
          <span>Aayush S. &middot; Bengaluru</span>
          <span style="color: #16a34a;">✔ Verified Buyer</span>
        </div>
      </div>
    </div>

    <!-- Review Card 3 -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
      <img src="//www.posterized.in/cdn/shop/files/wall2_69c63966-8ab6-48fa-9375-c74d0bd91c33.jpg?v=1792933724&width=500" alt="Spider-verse review" style="width: 100%; aspect-ratio: 4/3; object-fit: cover;">
      <div style="padding: 1.25rem;">
        <div style="color: #f59e0b; font-size: 0.9rem; margin-bottom: 0.4rem;">★ ★ ★ ★ ★</div>
        <p style="font-size: 0.9rem; color: #334155; line-height: 1.5; margin: 0 0 0.75rem;">"The colors are so vibrant and matte! Zero reflection from my monitor or ceiling tube light. 10/10 recommendation."</p>
        <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: #64748b; font-weight: 700;">
          <span>Sneha K. &middot; Delhi</span>
          <span style="color: #16a34a;">✔ Verified Buyer</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Reviews Page",
  "settings": []
}
{% endschema %}
